{
  "name": "@flow-profile/cli",
  "version": "0.0.1",
  "description": "Command-line interface for Flow Profile",
  "type": "module",
  "bin": {
    "flow-profile": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "echo 'No tests yet'",
    "lint": "echo 'No lint config yet'",
    "build": "bun run --cwd ../core build && tsc -p tsconfig.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "node-red",
    "flow-profile",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@flow-profile/core": "workspace:*"
  },
  "devDependencies": {}
}
