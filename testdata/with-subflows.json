[
  {
    "id": "tab1",
    "type": "tab",
    "label": "Main Flow",
    "disabled": false
  },
  {
    "id": "subflow-def-1",
    "type": "subflow",
    "name": "Simple Subflow",
    "info": "A simple subflow with one input and one output",
    "in": [
      {
        "x": 50,
        "y": 30,
        "wires": [{ "id": "sf1-internal-1" }]
      }
    ],
    "out": [
      {
        "x": 350,
        "y": 30,
        "wires": [{ "id": "sf1-internal-2", "port": 0 }]
      }
    ]
  },
  {
    "id": "sf1-internal-1",
    "type": "function",
    "z": "subflow-def-1",
    "name": "Process Input",
    "x": 150,
    "y": 80,
    "wires": [["sf1-internal-2"]],
    "func": "msg.payload = msg.payload.toUpperCase();\nreturn msg;"
  },
  {
    "id": "sf1-internal-2",
    "type": "change",
    "z": "subflow-def-1",
    "name": "Add Metadata",
    "x": 300,
    "y": 80,
    "wires": [[]],
    "rules": [{ "t": "set", "p": "processed", "pt": "msg", "to": "true", "tot": "bool" }]
  },
  {
    "id": "subflow-def-nested",
    "type": "subflow",
    "name": "Nested Subflow",
    "info": "A subflow that contains another subflow instance",
    "in": [
      {
        "x": 50,
        "y": 30,
        "wires": [{ "id": "nested-internal-1" }]
      }
    ],
    "out": [
      {
        "x": 450,
        "y": 30,
        "wires": [{ "id": "nested-instance", "port": 0 }]
      }
    ]
  },
  {
    "id": "nested-internal-1",
    "type": "debug",
    "z": "subflow-def-nested",
    "name": "Log Before",
    "x": 150,
    "y": 80,
    "wires": [["nested-instance"]],
    "active": true
  },
  {
    "id": "nested-instance",
