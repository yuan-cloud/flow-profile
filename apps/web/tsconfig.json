{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@flow-profile/core": [
        "../../packages/core/src/index.ts"
      ],
      "@flow-profile/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@flow-profile/ai": [
        "../../packages/ai/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
